<?xml version="1.0" encoding="UTF-8"?>
<!--
  log-platform 自身服务日志配置，对应 detailed-design §5.1。
  - pattern 暴露 MDC 中的 requestId / appId，便于串联一次请求
  - Authorization header 全程禁止打印；异常 message 内 lpk_* 在 GlobalExceptionHandler 已脱敏
  - 仅控制台 appender；生产由运行环境（Docker / K8s stdout）收集
-->
<configuration>

    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] [%X{requestId:-}] [%X{appId:-}] %logger{36} - %msg%n"/>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <logger name="com.hj.log" level="INFO"/>
    <logger name="org.springframework" level="WARN"/>
    <logger name="org.apache.ibatis" level="WARN"/>
    <logger name="org.mybatis" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>

</configuration>
