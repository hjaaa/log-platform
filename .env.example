# 复制为 .env 后填入真实值；.env 已被 .gitignore 排除。
# REQ-2026-001 详细见 requirements/REQ-2026-001/artifacts/detailed-design.md §8

# === 必填：JDK 21（项目使用 record / release 21 语法，JDK 11 无法编译）===
# macOS 团队默认装在 ~/devsoft/jdk-21.0.10.jdk
# 可用 `java -version` 自检；不为 21 时取消下面注释或换成你本机的 JDK 21 路径
# JAVA_HOME=/Users/richardhuang/devsoft/jdk-21.0.10.jdk/Contents/Home
# PATH=$JAVA_HOME/bin:$PATH

# === 必填：admin token ===
# 生成命令：openssl rand -hex 32
LOG_PLATFORM_ADMIN_TOKEN=replace-me-with-openssl-rand-hex-32

# === 必填：数据库连接 ===
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/log_platform?useSSL=false&serverTimezone=UTC&characterEncoding=utf8mb4
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=replace-me

# === 可选：覆盖默认值 ===
# LOG_PLATFORM_RETENTION_DAYS=7
# LOG_PLATFORM_INGESTION_MAX_BATCH_SIZE=200
